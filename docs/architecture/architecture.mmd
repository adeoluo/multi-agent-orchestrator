flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Cli(["CLI<br/>run, compare, durable"]):::edge
        Client(["HTTP client<br/>JSON goal"]):::edge
        Router["HTTP router<br/>/run, /compare"]:::core
        Validate["Validation<br/>goal up to 2000 chars"]:::control
        Cli ~~~ Client --> Router --> Validate
    end

    subgraph Core["Orchestration"]
        direction TB
        Orch["Orchestrator loop<br/>bounded iterations"]:::core
        Planner["Planners<br/>keyword, template, fixed"]:::core
        Graph["Plan validation<br/>missing deps, cycles"]:::control
        Workers["Workers<br/>built-in, ToolWorker"]:::core
        Critic["Critic<br/>approve or retry"]:::control
        Consensus["Consensus<br/>majority, unanimous"]:::core
        Orch --> Planner --> Graph ~~~ Workers --> Critic ~~~ Consensus
    end

    subgraph State["Data and state"]
        direction TB
        Board[("Blackboard<br/>plan, results, log")]:::data
        Memory[("SharedMemory<br/>agent scratchpad")]:::data
        Checkpoint[("JSON checkpoints<br/>durable resume")]:::data
        Board ~~~ Memory ~~~ Checkpoint
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        RunMetrics["run_metrics<br/>attempts, retries"]:::obs
        Trace["run_to_json<br/>lossless run record"]:::obs
        Compare["Comparison<br/>vs single-agent baseline"]:::obs
        Prom["/metrics<br/>Prometheus text"]:::obs
        RunMetrics ~~~ Trace ~~~ Compare ~~~ Prom
    end

    Interfaces -->|goal| Core
    Core -->|plan, verdicts| State
    State -.->|run state| Obs
    Core -->|runs, timings| Obs
